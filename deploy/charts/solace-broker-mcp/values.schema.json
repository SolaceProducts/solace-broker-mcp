{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "solace-broker-mcp chart values",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "global": {
      "type": "object"
    },
    "nameOverride": {
      "type": "string"
    },
    "fullnameOverride": {
      "type": "string"
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string"
        },
        "pullPolicy": {
          "type": "string",
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      }
    },
    "replicaCount": {
      "type": "integer",
      "minimum": 0
    },
    "brokers": {
      "type": "object",
      "description": "Broker name -> connection. Names follow the server's alias rule (internal/config/config.go).",
      "propertyNames": {
        "pattern": "^[A-Za-z0-9]([A-Za-z0-9-]{0,61}[A-Za-z0-9])?$"
      },
      "additionalProperties": {
        "type": [
          "object",
          "null"
        ],
        "additionalProperties": false,
        "properties": {
          "url": {
            "type": "string",
            "description": "http(s) SEMP URL. Validated in the template, not here: Helm prints a schema-rejected value in full, and a malformed url may carry credentials."
          },
          "insecureSkipVerify": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "envPrefix": {
            "type": [
              "string",
              "null"
            ]
          },
          "auth": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "mode": {
                "type": [
                  "string",
                  "null"
                ],
                "enum": [
                  "basic",
                  "bearer",
                  null
                ]
              },
              "username": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "password": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "token": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "existingSecret": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        }
      }
    },
    "mcpClientAuth": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "static"
          ]
        },
        "devToken": {
          "type": [
            "string",
            "null"
          ]
        },
        "existingSecret": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "server": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "port": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 65535
        },
        "logLevel": {
          "type": [
            "string",
            "null"
          ]
        },
        "listenAddress": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "semp": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "maxConcurrentPerBroker": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 1024
        },
        "requestTimeoutDuration": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^\\+?(0|(([0-9]+(\\.[0-9]*)?|\\.[0-9]+)(ns|us|µs|μs|ms|s|m|h))+)$"
        },
        "requestMinInterval": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^\\+?(0|(([0-9]+(\\.[0-9]*)?|\\.[0-9]+)(ns|us|µs|μs|ms|s|m|h))+)$"
        },
        "maxQueueWait": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^\\+?(0|(([0-9]+(\\.[0-9]*)?|\\.[0-9]+)(ns|us|µs|μs|ms|s|m|h))+)$"
        },
        "fairScheduling": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "retries": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "retryMinInterval": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^\\+?(0|(([0-9]+(\\.[0-9]*)?|\\.[0-9]+)(ns|us|µs|μs|ms|s|m|h))+)$"
        },
        "retryMaxInterval": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^\\+?(0|(([0-9]+(\\.[0-9]*)?|\\.[0-9]+)(ns|us|µs|μs|ms|s|m|h))+)$"
        }
      }
    },
    "resources": {
      "type": "object"
    },
    "goMemLimit": {
      "type": "string"
    },
    "observability": {
      "type": "object",
      "additionalProperties": false,
      "description": "Cross-field rules (an otlpEndpoint with no OTLP consumer, the metrics port) are enforced in the templates, not here.",
      "properties": {
        "otlpEndpoint": {
          "type": "string",
          "description": "OTEL_EXPORTER_OTLP_ENDPOINT (OTLP/gRPC)."
        },
        "correlationId": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean",
              "description": "OBS_CORRELATION_ID_ENABLED"
            }
          }
        },
        "tracing": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean",
              "description": "OBS_TRACING_ENABLED"
            }
          }
        },
        "auditLog": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean",
              "description": "OBS_AUDIT_LOG_ENABLED"
            }
          }
        },
        "saturationEvents": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean",
              "description": "OBS_SATURATION_EVENTS_ENABLED"
            }
          }
        },
        "authFailureCounter": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": [
                "boolean",
                "null"
              ],
              "description": "OBS_AUTH_FAILURE_COUNTER_ENABLED; null follows the metrics switches."
            }
          }
        },
        "metrics": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "bindAddress": {
              "type": [
                "string",
                "null"
              ],
              "description": "observability.metrics_bind_address; null = the server default \":9091\". Format checked in the template."
            },
            "scrape": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "enabled": {
                  "type": "boolean",
                  "description": "OBS_METRICS_SCRAPE_ENABLED"
                }
              }
            },
            "otlp": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "enabled": {
                  "type": "boolean",
                  "description": "OBS_METRICS_OTLP_ENABLED"
                }
              }
            }
          }
        },
        "serviceMonitor": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "additionalLabels": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "metricsNamespace": {
          "type": "string"
        }
      }
    },
    "podDisruptionBudget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "ingress": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "className": {
          "type": "string"
        },
        "host": {
          "type": "string"
        },
        "tls": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "secretName": {
              "type": "string"
            }
          }
        },
        "annotations": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "string",
              "null"
            ]
          },
          "description": "Set a default key to null to remove it."
        }
      }
    },
    "extraEnv": {
      "type": "array",
      "description": "Full Kubernetes EnvVar entries (value or valueFrom).",
      "items": {
        "type": "object",
        "required": [
          "name"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "value": {
            "type": "string"
          },
          "valueFrom": {
            "type": "object"
          }
        }
      }
    }
  }
}
