# Jaeger backend. Use with: docker compose --env-file .env.jaeger up
# Jaeger UI: http://localhost:16686
COMPOSE_PROFILES=jaeger
OTEL_BACKEND_ENDPOINT=jaeger:4317

# Dev token for the static auth mode. Change this before exposing the server
# on any network beyond your local machine.
MCP_DEV_TOKEN=change-me
