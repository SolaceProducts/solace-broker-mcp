# LLM e2e eval suite configuration.
#
# Source-able shell file; both runners auto-load it. Every value uses
# ${VAR:-default} so anything you export beforehand wins:
#
#   MCP_URL=http://other-host:9090 ./run-all.sh
#
# MCP_URL is the server's *base* URL — runners and templates append the
# `/mcp` path themselves. A trailing slash or trailing `/mcp` on the
# override is normalized away below, so callers don't need to remember
# which shape this file expects.
#
# Never commit secrets here. LLM_SERVICE_API_KEY must come from the
# environment (CI: vault; local: shell rc).

# ── LLM service ─────────────────────────────────────────────────────────────
# Endpoint Claude Code talks to. Leave empty to use the CLI's ambient login
# (~/.claude) — handy for local dev. CI sets this to the LiteLLM proxy.
LLM_SERVICE_ENDPOINT="${LLM_SERVICE_ENDPOINT:-}"
LLM_SERVICE_MODEL_NAME="${LLM_SERVICE_MODEL_NAME:-}"
# LLM_SERVICE_API_KEY — never defaulted here. Export it in your shell.

# ── Claude Code CLI pin ─────────────────────────────────────────────────────
# Single source of truth: package.json. Renovate bumps the dep there
# natively, and this read picks it up — no regex matchers, no two-place
# sync. CLAUDE_VERSION_PIN_OVERRIDE=1 skips the runner's mismatch check
# during local experimentation.
_LLM_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PINNED_CLAUDE_VERSION="${PINNED_CLAUDE_VERSION:-$(jq -r '.dependencies."@anthropic-ai/claude-code"' "$_LLM_DIR/package.json")}"

# ── Broker target ───────────────────────────────────────────────────────────
# Selects which targets/<name>.env file is sourced for MCP endpoint, bearer
# token, and broker aliases. Ship `local-docker` (defaults) and
# `lab-broker.example` (template) — add your own targets/<name>.env to
# point the suite at any other MCP server.
#
# `./setup-fixtures.sh` only provisions fixtures for local-docker; other
# targets are assumed already running at $MCP_URL.
BROKER_TARGET="${BROKER_TARGET:-local-docker}"

_TARGET_FILE="$_LLM_DIR/targets/${BROKER_TARGET}.env"
if [ ! -f "$_TARGET_FILE" ]; then
    echo "[ERROR] BROKER_TARGET='$BROKER_TARGET' has no target file at $_TARGET_FILE" >&2
    echo "[HINT]  available targets: $(ls "$_LLM_DIR/targets" 2>/dev/null | grep '\.env$' | sed 's/\.env$//' | tr '\n' ' ')" >&2
    return 1 2>/dev/null || exit 1
fi
# shellcheck disable=SC1090
source "$_TARGET_FILE"

# Normalize MCP_URL to a base URL — strip trailing `/` and a trailing
# `/mcp`. Runners and templates append `/mcp` themselves, so an override
# like `MCP_URL=http://x:9090/mcp` would otherwise yield `…/mcp/mcp`.
# helpers.sh does the same thing; replicating it here makes config.env
# safe on its own (e.g. the run-all.sh fallback when helpers.sh isn't
# on disk).
MCP_URL="${MCP_URL%/}"
MCP_URL="${MCP_URL%/mcp}"

unset _LLM_DIR _TARGET_FILE
