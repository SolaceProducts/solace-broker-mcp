# Single source of truth for the e2e-oauth suite configuration.
# Read by: docker-compose.yml, helpers.sh (via e2e-common/lib.sh),
# configure-oauth-profiles.sh, and the MCP server config generated by
# write_oauth_config.
#
# Ports are distinct from every other e2e suite (which claim 8080-8100) so this
# suite can run side by side with them locally.

# Broker SEMP ports (host-side). "prod-us" requires audience solace-broker,
# "test-us" requires audience solace-broker-second — mirrors the two audience
# mappers on mcp-server-client in realm-export.json.
BROKER_A_SEMP_PORT=8102
BROKER_B_SEMP_PORT=8104

# Broker SEMP-over-TLS ports (host-side). OAuth-mode brokers must be addressed
# over https (validateBrokerURL enforces this) — the standard Solace image
# listens for SEMP-TLS on container port 1943 by default (serviceSempTlsEnabled),
# but ships with NO server certificate installed; configure-oauth-profiles.sh
# installs a self-signed one via SEMP before the MCP server can connect.
BROKER_A_SEMP_TLS_PORT=2943
BROKER_B_SEMP_TLS_PORT=2945

# Broker admin bootstrap credentials — used only to configure the OAuth profile
# itself via SEMP (configure-oauth-profiles.sh). Tool calls against the brokers
# during the test scenarios go through the OAuth token-exchange path instead.
BROKER_USERNAME=admin
BROKER_PASSWORD=admin

# MCP server port (TLS — OAuth mode enforces TLS on the server's own listener).
MCP_PORT=9093

# Keycloak ports, distinct from the common 8443/8080 default to reduce local
# port-collision risk.
KEYCLOAK_HTTPS_PORT=18543
KEYCLOAK_HTTP_PORT=18280

# Keycloak realm/client configuration (must match realm-export.json).
# Derived URLs (issuer, token endpoint, JWKS) are built from these in
# helpers.sh/setup-brokers.sh rather than nested here — Docker Compose's .env
# parser does not perform shell-style ${VAR} interpolation between lines, so
# composed values are computed in bash instead, where sourcing guarantees it.
KEYCLOAK_REALM=mcp-test-realm

# Hop 1: agent -> MCP server. Public client, direct (password) grant enabled —
# used to mint test-user JWTs without a browser.
HOP1_CLIENT_ID=agentic-app-client
HOP1_AUDIENCE=mcp-server-client

# Same as HOP1_CLIENT_ID but without the realm-roles-to-groups protocol mapper,
# so its tokens carry no `groups` claim. Used only by the tool-RBAC
# missing-claim scenario. Both clients target the same HOP1_AUDIENCE, so tokens
# from either pass hop-1 authentication identically — the only difference is
# the claim set, which is exactly the property under test.
HOP1_CLIENT_ID_NOGROUPS=agentic-app-client-nogroups

# Hop 2: MCP server -> broker. Confidential client. Secret is stable across
# realm-export.json re-imports (test-realm-only secret, not a production
# credential).
HOP2_CLIENT_ID=mcp-server-client
HOP2_CLIENT_SECRET=qrnZwPfpynmbzcfjfBv1dP9wFPvNgaDg

# Test users, defined in realm-export.json with this password already hashed
# into the export (no separate password-reset step needed).
TEST_ADMIN_USER=test-admin-user
TEST_READONLY_USER=test-readonly-user
TEST_USER_PASSWORD=password

# Broker aliases used in the generated MCP server config + audiences required
# by each broker's OAuth profile.
BROKER_A_ALIAS=prod-us
BROKER_A_AUDIENCE=solace-broker
BROKER_B_ALIAS=test-us
BROKER_B_AUDIENCE=solace-broker-second
