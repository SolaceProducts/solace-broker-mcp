# Single source of truth for E2E test configuration.
# Read by: docker-compose.yml, helpers.sh, and the MCP server (via ENV_FILE).

# Broker SEMP ports (host-side)
BROKER_A_SEMP_PORT=8080
BROKER_B_SEMP_PORT=8082

# Broker credentials (shared by both brokers)
BROKER_USERNAME=admin
BROKER_PASSWORD=admin

# MCP server credential env vars (resolved via env_prefix in broker-config.yaml)
E2E_A_USERNAME=admin
E2E_A_PASSWORD=admin
E2E_B_USERNAME=admin
E2E_B_PASSWORD=admin
