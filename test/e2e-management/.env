# Single source of truth for the e2e-management suite configuration.
# Read by: docker-compose.yml, helpers.sh (via e2e-common/lib.sh), and the MCP
# server (via ENV_FILE). Broker ports are distinct from the other e2e suites so
# their containers don't clash; the MCP server port is shared (9090 default), so
# suites run sequentially, not concurrently.

# Broker SEMP ports (host-side)
BROKER_A_SEMP_PORT=8094
BROKER_B_SEMP_PORT=8096

# Broker credentials (shared by both brokers)
BROKER_USERNAME=admin
BROKER_PASSWORD=admin

# MCP server credential env vars (resolved via ${VAR_NAME} substitution in broker config)
E2E_A_USERNAME=admin
E2E_A_PASSWORD=admin
E2E_B_USERNAME=admin
E2E_B_PASSWORD=admin

# Static bearer token shared by the MCP server (mcp_client_auth.dev_token) and every
# e2e client (curl in the shared lib). Same ${VAR} substitution pattern as credentials.
MCP_DEV_TOKEN=e2e-static-dev-token
