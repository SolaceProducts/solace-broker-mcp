# Template — copy to lab-broker.env and fill in. lab-broker.env is
# gitignored so secrets don't leak. Activate with BROKER_TARGET=lab-broker.
#
# This target assumes the MCP server is already running against your lab
# broker — ./setup-fixtures.sh is a no-op for non-local-docker targets.
# Fixture-dependent scenarios (F3/F4/F5/F6 and most F-series) will only
# pass if the lab broker has the equivalent fixture state.

# MCP server base URL — no /mcp path suffix. Callers append /mcp.
MCP_URL="${MCP_URL:-https://mcp.lab.example.com}"
MCP_BEARER_TOKEN="${MCP_BEARER_TOKEN:-FILL_ME_IN_OR_EXPORT}"

# Broker aliases configured in the MCP server at MCP_URL. List every
# broker run-all.sh should probe during precheck.
PRECHECK_BROKERS="${PRECHECK_BROKERS:-lab-broker-1}"

# Closed-port base URL for the safety-mcp-down scenario. Default works
# if the runner can reach localhost; override if the CI runner can't.
MCP_URL_DOWN="${MCP_URL_DOWN:-http://localhost:9099}"
