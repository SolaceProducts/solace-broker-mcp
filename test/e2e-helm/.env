# Single source of truth for the e2e-helm suite configuration.
# Read by: docker-compose.yml, helpers.sh (via e2e-common/lib.sh), run-all.sh and
# helm-chart-e2e.yml. Broker and MCP ports are distinct from the other e2e suites
# so their containers and port-forwards don't clash.

# Broker SEMP ports (host-side). lib.sh's wait_for_all_brokers polls these; the
# pods reach the brokers on their container port 8080 over kind's Docker network.
BROKER_A_SEMP_PORT=8106
BROKER_B_SEMP_PORT=8108

# Broker admin credentials (shared by both brokers). Used by lib.sh only — for
# readiness and SEMP setup — never handed to the chart.
BROKER_USERNAME=admin
BROKER_PASSWORD=admin

# The chart's broker credentials: a user that exists on one broker only
# (docker-compose.yml), so credentials routed to the wrong broker fail
# authentication. A: chart-managed. B: the existingSecret.
CHART_A_USERNAME=e2ehelma
CHART_A_PASSWORD=e2e-helm-chart-a
CHART_B_USERNAME=e2ehelmb
CHART_B_PASSWORD=e2e-helm-chart-b

# Host side of the `kubectl port-forward` to the chart's Service. lib.sh derives
# MCP_URL from it.
MCP_PORT=9097

# Placeholder only: run-all.sh replaces it with a random per-run token, which is
# what the chart is installed with. Defined because lib.sh exports it.
MCP_DEV_TOKEN=unused-replaced-per-run

# kind cluster. The node image is the default of the pinned kind release, by
# digest (kind release notes). helm-chart-e2e.yml installs kind at KIND_VERSION,
# so CI and local runs create the same cluster.
KIND_VERSION=v0.33.0
KIND_NODE_IMAGE=kindest/node:v1.37.0@sha256:a1ed56cfb0e7b93589bdf97c8cd566405a265939e3620fc4f5de89adff580ae5
KIND_CLUSTER=sol-e2e-helm

# Chart install. The image is the nightly dev build (linux/amd64 only), the
# same one test/e2e-dashboard pulls.
HELM_NAMESPACE=mcp-e2e
HELM_RELEASE=e2e
MCP_IMAGE_REPOSITORY=ghcr.io/solaceproducts/solace-broker-mcp-dev
MCP_IMAGE_TAG=dev
