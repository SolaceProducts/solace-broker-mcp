# Copy to .env (gitignored). Do not commit .env.
# Tenant / app / group IDs belong here too — never in git.

# mcp-broker confidential-client secret (Hop 2 token-exchange).
MCP_SERVER_CLIENT_SECRET=

# Directory tenant (GUID). Issuer and token URLs are built from this.
ENTRA_TENANT_ID=

# mcp-broker confidential client — Hop 1 audience + Hop 2 token-exchange client.
MCP_BROKER_CLIENT_ID=

# mcp-agent public client — Claude `mcp add` (no secret).
MCP_AGENT_CLIENT_ID=

# test-broker-us — SEMP resourceServerRequiredAudience and prod-us OBO target.
BROKER_RESOURCE_APP_ID=

# Entra security-group object ID mapped to the broker SEMP access-level group.
ENTRA_GROUP_OBJECT_ID=

# App role / SEMP required scope on the broker resource app.
BROKER_OAUTH_REQUIRED_SCOPE=

# MCP resource (App ID URI host + PRM resource_url). Hosts file must match.
MCP_RESOURCE_HOST=
MCP_RESOURCE_URL=
MCP_ACCESS_AS_USER_SCOPE=

# Lab sign-in user (not a GUID).
LAB_OPERATOR_UPN=

# Unregistered resource so test-us OBO 400s. Not a real Entra app.
OBO_PROBE_RESOURCE_APP_ID=
