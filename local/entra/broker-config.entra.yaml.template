# Entra lab: Hop 1 (mcp_client_auth) + Hop 2 OBO (jwt-bearer).
# local-basic stays basic (no OBO). prod-us and test-us share the one lab
# broker resource app (test-broker-us); Entra has no per-alias audience.
#
# Hop 2 invalid_grant probe: test-us auth.target is a resource this MCP app
# is not allowed to OBO. prod-us stays the working target. Call list-vpns
# with broker test-us. Expect tool isError, log ErrExchangeRejected, Entra
# 400 (invalid_grant / invalid_resource + error_codes). Restore by copying
# prod-us's target line onto test-us.
#
# KnownFields(true): use auth.target, not auth.scopes. jwt-bearer omits
# audience_parameter_name (RFC 8693 only).
port: 19090
log_level: debug

# Dev-only: brokers use self-signed certs. Required when insecure_skip_verify
# is set on any broker while mcp_client_auth.mode is "oauth".
allow_insecure_broker_tls: true

# Required for the Ops group's queue/VPN write tools (create/update/delete) to
# register at all — enable_write_tools gates every non-read-only tool at
# registration time, before RBAC even runs. Default is false.
enable_write_tools: true

# Rendered by `make config` — @@CERT_ROOT@@ and @@ENTRA_*@@ / @@MCP_*@@ /
# @@BROKER_*@@ placeholders come from entra-ids.sh. Edit that file for IDs;
# edit this template for shape. Do not edit the rendered file.
tls_cert_file: "@@CERT_ROOT@@/mcp-server/mcp-server.crt"
tls_key_file: "@@CERT_ROOT@@/mcp-server/mcp-server.key"

mcp_client_auth:
  mode: oauth
  issuer: "https://login.microsoftonline.com/@@ENTRA_TENANT_ID@@/v2.0"
  audience: "@@MCP_BROKER_CLIENT_ID@@"
  resource_url: "@@MCP_RESOURCE_URL@@"
  # Keep both. openid = OIDC sign-in (Learn: Sign you in / sub / ID token).
  # The access_as_user URI = token for this MCP API. Microsoft combined-
  # consent example is openid + {resource}/.default. Do not skip openid;
  # 9010010 was openid alone, not the pair.
  scopes_supported:
    - "openid"
    - "@@MCP_ACCESS_AS_USER_SCOPE@@"
  tool_authorization:
    enabled: true
    # Narrow tools/list to what each caller may invoke (SOL-152888). Set false
    # to serve every registered tool; authorization on tools/call is unaffected.
    filter_tools_list: true
    groups_claim_name: "roles"
    access_level_groups:
      operator:
        - clear-client-stats
        - clear-queue-stats
        - create-message-vpn
        - create-queue
        - create-rdp
        - create-topic-endpoint
        - delete-message-vpn
        - delete-queue
        - delete-queue-messages
        - delete-rdp
        - delete-topic-endpoint
        - disconnect-client
        - get-bridge-status
        - get-broker-status
        - get-client-details
        - get-kafka-receiver-status
        - get-kafka-sender-status
        - get-message-rates
        - get-rdp-status
        - get-redundancy-status
        - get-replication-status
        - get-vpn-status
        - list-bridges
        - list-client-subscriptions
        - list-clients
        - list-kafka-receivers
        - list-kafka-senders
        - list-queue-discards
        - list-queues
        - list-rdps
        - list-slow-subscribers
        - list-vpns
        - update-message-vpn
        - update-queue
        - update-rdp
        - update-topic-endpoint
      reader:
        - get-bridge-status
        - get-broker-status
        - get-client-details
        - get-kafka-receiver-status
        - get-kafka-sender-status
        - get-message-rates
        - get-rdp-status
        - get-redundancy-status
        - get-replication-status
        - get-vpn-status
        - list-bridges
        - list-client-subscriptions
        - list-clients
        - list-kafka-receivers
        - list-kafka-senders
        - list-queue-discards
        - list-queues
        - list-rdps
        - list-slow-subscribers
        - list-vpns

broker_oauth:
  idp_token_endpoint: "https://login.microsoftonline.com/@@ENTRA_TENANT_ID@@/oauth2/v2.0/token"
  mcp_server_client_id: "@@MCP_BROKER_CLIENT_ID@@"
  mcp_server_client_auth:
    client_secret_post:
      secret: "${MCP_SERVER_CLIENT_SECRET}"
  grant_type: "urn:ietf:params:oauth:grant-type:jwt-bearer"
  # audience_parameter_name omitted — RFC 8693 only; Entra OBO uses auth.target.

semp:
  max_concurrent_per_broker: 10
  request_timeout_duration: 30s
  request_min_interval: 50ms
  retries: 2
  retry_min_interval: 200ms
  retry_max_interval: 2s

brokers:
  prod-us:
    url: "https://localhost:21943"
    insecure_skip_verify: true
    auth:
      mode: oauth
      # test-broker-us Application ID URI + MSAL .default.
      target: "api://@@BROKER_RESOURCE_APP_ID@@/.default"
  test-us:
    url: "https://localhost:21945"
    insecure_skip_verify: true
    auth:
      mode: oauth
      # Working: api://@@BROKER_RESOURCE_APP_ID@@/.default
      # Probe: unregistered resource so OBO 400s (not a Hop 1 / jwt-bearer change).
      target: "api://@@OBO_PROBE_RESOURCE_APP_ID@@/.default"
  local-basic:
    url: "https://localhost:21944"
    insecure_skip_verify: true
    auth:
      mode: basic
      username: "admin"
      password: "admin"
